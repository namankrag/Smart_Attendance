# syntax=docker/dockerfile:1
# Smart Attendance — Streamlit UI image (Python 3.11).
# dlib is included for the active 128-D face enrollment/matching flow.
# Heavier voice models and the not-yet-integrated 512-D ONNX pipeline
# remain in the separate worker image (Dockerfile.worker).
FROM python:3.11-slim AS ui

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# requirements-ui.txt includes the dlib face backend and its model
# package so face registration, login, and classroom attendance all use
# the same 128-D templates.
COPY requirements-ui.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py ./app.py
COPY src ./src
COPY img ./img

EXPOSE 8501

# Streamlit XSRF and CORS protection stay ON (SPEC Phase 3 / audit 44:
# never disable them).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=4)"

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]
