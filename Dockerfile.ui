# syntax=docker/dockerfile:1
# Smart Attendance — light Streamlit UI image (Phase 2).
# Contains NO torch / dlib / onnxruntime / pyannote: all ML runs in the
# worker image (Dockerfile.worker). Python 3.11 target.
FROM python:3.11-slim AS ui

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# requirements-ui.txt is the UI dependency set: streamlit, supabase,
# argon2-cffi, scipy, httpx, pillow — no ML libraries. (The legacy
# dlib/resemblyzer lines below are the pre-Phase-2 stack, kept for
# local dev / transition; the UI image build uses requirements-ui.txt
# and must not install them. The legacy pipeline modules import dlib /
# resemblyzer defensively, so the UI boots without them and legacy
# in-process ML calls fail loudly until the worker cutover.)
COPY requirements-ui.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py ./app.py
COPY src ./src
COPY img ./img

EXPOSE 8501

# Streamlit XSRF and CORS protection stay ON (SPEC Phase 3 / audit 44:
# never disable them).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=4)"

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]
