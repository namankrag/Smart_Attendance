# Shared by the local Docker Compose stack.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Worker-only secrets. Never copy these into Streamlit secrets.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN

# Use the same generated random value in .streamlit/secrets.toml.
API_INTERNAL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional Postgres DSN for the inference job queue.
DATABASE_URL=
