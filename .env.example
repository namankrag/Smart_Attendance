# Smart Attendance — example environment file (Phase 3).
# Copy this file to `.env` and fill in REAL values. NEVER commit `.env`
# (it is gitignored) and NEVER put real values in this example file.
#
# UI service (docker-compose `ui`): SUPABASE_URL + SUPABASE_ANON_KEY only.
# WORKER service (docker-compose `worker`): the service_role key and
# HF_TOKEN live here — the UI must never see them.
#
# Supabase project URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase ANON (publishable) key — the only key the Streamlit UI uses.
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
# Base URL of the ML worker (compose sets this to http://worker:8000).
ML_WORKER_URL=http://worker:8000

# --- Worker only (never in the UI service) ---------------------------------
# Postgres DSN for the worker's FOR UPDATE SKIP LOCKED job queue.
# DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Supabase service_role key — bypasses RLS; worker host only.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
# Hugging Face token for pyannote diarization model downloads at build time.
# HF_TOKEN=YOUR-HF-TOKEN
