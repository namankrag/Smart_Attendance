# Smart Attendance — example Streamlit secrets (Phase 3).
# Copy this file to `.streamlit/secrets.toml` and fill in REAL values.
# NEVER commit `.streamlit/secrets.toml` (it is gitignored) and NEVER
# put real values in this example file.
#
# SUPABASE_URL: your Supabase project URL, e.g. https://YOUR-PROJECT.supabase.co
# SUPABASE_KEY: the Supabase ANON (publishable) key ONLY.
#   The service_role key bypasses Row Level Security and must NEVER be
#   placed here or anywhere in the Streamlit app — it lives in the ML
#   worker environment only (see .env.example).
# APP_URL: base URL used in join links and QR codes (optional).
#
# Google OIDC (Phase 1, Google-first login via st.login("google")):
#   With a named provider, the SHARED settings redirect_uri and
#   cookie_secret MUST live in [auth]; [auth.google] holds ONLY
#   client_id / client_secret / server_metadata_url. Do NOT put
#   redirect_uri or cookie_secret under [auth.google] — Streamlit
#   ignores them there and login breaks.
#   cookie_secret must be a strong random string (generate a fresh one
#   per deployment); never commit the real secrets.toml.
#   Google Cloud must ALSO list the Streamlit redirect URI below as an
#   Authorized redirect URI, in addition to the Supabase callback, or
#   Google login fails with redirect_uri_mismatch.

SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_KEY = "YOUR-SUPABASE-ANON-KEY"

# Optional: base URL used in join links and QR codes.
APP_URL = "https://your-app-url.streamlit.app"

[auth]
# Local dev redirect. When deployed, replace this with
# "https://<app>.streamlit.app/oauth2callback" (your deployed app URL).
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "<strong-random-secret>"

[auth.google]
client_id = "YOUR-GOOGLE-OAUTH-CLIENT-ID"
client_secret = "YOUR-GOOGLE-OAUTH-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
